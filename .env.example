# CampusFix AI — local admin configuration
# Copy to .env, generate a password hash, then fill in the values.
# Never commit .env. It is already listed in .gitignore.

# Generate a hash with:
# .venv/bin/python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-strong-password'))"
SECRET_KEY=replace-with-a-random-64-character-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-the-generated-werkzeug-password-hash-here

# Set true only when serving the app over HTTPS in production.
SESSION_COOKIE_SECURE=false
